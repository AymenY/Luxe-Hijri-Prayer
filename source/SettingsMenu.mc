import Toybox.Activity;
import Toybox.Application;
import Toybox.Lang;
import Toybox.WatchUi;

// On-watch settings: watch face menu -> Settings (or Customise). The structure comes from
// MenuTable.mc (generated by tools/gen_settings.py). Every choice is written to
// Application.Properties, the same storage as the Garmin Connect settings, and applied at once.
module SettingsMenu {

    function root() as WatchUi.Menu2 {
        var menu = new WatchUi.Menu2({:title => text(Rez.Strings.M_Title)});
        var groups = MenuTable.groups();
        for (var i = 0; i < groups.size(); i++) {
            menu.addItem(new WatchUi.MenuItem(text((groups[i] as Array)[0]), null, i, null));
        }
        return menu;
    }

    function text(id) as String {
        return WatchUi.loadResource(id) as String;
    }

    // Stored list index of a property (0 when missing or invalid).
    function current(key as String) as Number {
        var v = null;
        try {
            v = Application.Properties.getValue(key);
        } catch (e) {
            return 0;
        }
        if (v instanceof Number) {
            return v;
        }
        if (v instanceof Float || v instanceof Double || v instanceof Long) {
            return v.toNumber();
        }
        return 0;
    }

    function store(key as String, value) as Void {
        try {
            Application.Properties.setValue(key, value);
        } catch (e) {
            return;
        }
        var app = Application.getApp();
        if (app instanceof LuxeHijriPrayerApp) {
            app.onSettingsChanged();
        }
    }

    // Title of the selected option, shown under the setting.
    function choice(item as Array) as String? {
        var opts = item[2];
        if (opts == null) {
            return null;
        }
        var o = opts as Array;
        var cur = current(item[0] as String);
        return (cur >= 0 && cur < o.size()) ? text(o[cur]) : null;
    }
}

// Root menu: one entry per group.
class LuxeRootDelegate extends WatchUi.Menu2InputDelegate {

    function initialize() {
        Menu2InputDelegate.initialize();
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        var group = MenuTable.groups()[item.getId() as Number] as Array;
        var items = group[1] as Array;
        var menu = new WatchUi.Menu2({:title => SettingsMenu.text(group[0])});
        for (var i = 0; i < items.size(); i++) {
            var it = items[i] as Array;
            menu.addItem(new WatchUi.MenuItem(SettingsMenu.text(it[1]), SettingsMenu.choice(it), i, null));
        }
        WatchUi.pushView(menu, new LuxeGroupDelegate(items), WatchUi.SLIDE_LEFT);
    }
}

// A group: a list setting opens its options; "#verses" the rotation check boxes; "#gps" stores
// the last position known to the watch as the prayer-time location.
class LuxeGroupDelegate extends WatchUi.Menu2InputDelegate {

    hidden var mItems as Array;

    function initialize(items as Array) {
        Menu2InputDelegate.initialize();
        mItems = items;
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        var it = mItems[item.getId() as Number] as Array;
        var key = it[0] as String;
        if (key.equals("#verses")) {
            var menu = new WatchUi.Menu2({:title => SettingsMenu.text(it[1])});
            var titles = MenuTable.verses();
            for (var i = 0; i < titles.size(); i++) {
                var on = Application.Properties.getValue("AyahInc" + (i + 1).format("%02d"));
                menu.addItem(new WatchUi.ToggleMenuItem(SettingsMenu.text(titles[i]), null, i,
                                                        !(on instanceof Boolean) || on, null));
            }
            WatchUi.pushView(menu, new LuxeVersesDelegate(), WatchUi.SLIDE_LEFT);
        } else if (key.equals("#gps")) {
            var info = Activity.getActivityInfo();
            var loc = (info != null) ? info.currentLocation : null;
            if (loc == null) {
                item.setSubLabel(SettingsMenu.text(Rez.Strings.M_GpsNone));
            } else {
                var deg = loc.toDegrees();
                Application.Properties.setValue("Latitude", (deg[0] as Double).toFloat());
                SettingsMenu.store("Longitude", (deg[1] as Double).toFloat());
                item.setSubLabel((deg[0] as Double).format("%.4f") + ", " + (deg[1] as Double).format("%.4f"));
            }
            WatchUi.requestUpdate();
        } else {
            var opts = it[2] as Array;
            var menu = new WatchUi.Menu2({:title => SettingsMenu.text(it[1])});
            for (var i = 0; i < opts.size(); i++) {
                menu.addItem(new WatchUi.MenuItem(SettingsMenu.text(opts[i]), null, i, null));
            }
            var cur = SettingsMenu.current(key);
            if (cur >= 0 && cur < opts.size()) {
                menu.setFocus(cur);
            }
            WatchUi.pushView(menu, new LuxeOptionDelegate(it, item), WatchUi.SLIDE_LEFT);
        }
    }
}

// Options of one setting: the selection is stored and the list closes.
class LuxeOptionDelegate extends WatchUi.Menu2InputDelegate {

    hidden var mSetting as Array;
    hidden var mParent as WatchUi.MenuItem;

    function initialize(setting as Array, parent as WatchUi.MenuItem) {
        Menu2InputDelegate.initialize();
        mSetting = setting;
        mParent = parent;
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        SettingsMenu.store(mSetting[0] as String, item.getId() as Number);
        mParent.setSubLabel(SettingsMenu.choice(mSetting));
        WatchUi.popView(WatchUi.SLIDE_RIGHT);
    }
}

// Verses of the hourly rotation (check boxes AyahInc01..39).
class LuxeVersesDelegate extends WatchUi.Menu2InputDelegate {

    function initialize() {
        Menu2InputDelegate.initialize();
    }

    function onSelect(item as WatchUi.MenuItem) as Void {
        if (item instanceof WatchUi.ToggleMenuItem) {
            SettingsMenu.store("AyahInc" + ((item.getId() as Number) + 1).format("%02d"), item.isEnabled());
        }
    }
}
