import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Math;
import Toybox.WatchUi;

// Draws vector art (resources/jsonData/*.json, generated by tools/build_assets.py). Shapes are
// described in 280 x 280 coordinates and colour roles; they are scaled to the screen and
// recoloured by the selected style preset. tools/face.py interprets the same data.
module Backgrounds {

    const OP_POLY = 0;        // [0, role, x1, y1, x2, y2, ...]          (convex)
    const OP_CIRCLE = 1;      // [1, role, x, y, r]
    const OP_LINE = 2;        // [2, role, pen, x1, y1, x2, y2]
    const OP_POLYLINE = 3;    // [3, role, pen, x1, y1, ...]
    const OP_POINTS = 4;      // [4, role, size, x1, y1, ...]
    const OP_RING = 5;        // [5, role, pen, x, y, r]
    const OP_RECT = 6;        // [6, role, x, y, w, h]
    const OP_STAR8 = 7;       // [7, role, pen, x, y, r]  8-point star outline (two squares)
    const OP_FILL = 8;        // [8, role]
    const OP_CRESCENT = 9;    // [9, role, maskRole, x, y, r, dx, dy, r2]
    const OP_RRECT = 10;      // [10, role, x, y, w, h, radius]
    const OP_RRECT_LINE = 11; // [11, role, pen, x, y, w, h, radius]

    function load(index as Number) as Array? {
        var id = Rez.JsonData.BgMosque;
        if (index == 1) {
            id = Rez.JsonData.BgGeometric;
        } else if (index == 2) {
            id = Rez.JsonData.BgMarble;
        } else if (index == 3) {
            id = Rez.JsonData.BgNight;
        }
        return WatchUi.loadResource(id) as Array?;
    }

    function loadFrame() as Array? {
        return WatchUi.loadResource(Rez.JsonData.Frame) as Array?;
    }

    // v (280-px units) -> device pixels
    function sc(v as Numeric, k as Float) as Number {
        return Math.floor(v * k + 0.5).toNumber();
    }

    function pen(w as Numeric, k as Float) as Number {
        var p = sc(w, k);
        return (p < 1) ? 1 : p;
    }

    function draw(dc as Graphics.Dc, ops as Array, colors as Array, k as Float) as Void {
        for (var i = 0; i < ops.size(); i++) {
            var op = ops[i] as Array<Number>;
            var code = op[0];
            dc.setColor(colors[op[1]] as Number, Graphics.COLOR_TRANSPARENT);
            if (code == OP_POLY) {
                var pts = [];
                for (var j = 2; j + 1 < op.size(); j += 2) {
                    pts.add([sc(op[j], k), sc(op[j + 1], k)]);
                }
                dc.fillPolygon(pts);
            } else if (code == OP_CIRCLE) {
                dc.fillCircle(sc(op[2], k), sc(op[3], k), sc(op[4], k));
            } else if (code == OP_LINE) {
                dc.setPenWidth(pen(op[2], k));
                dc.drawLine(sc(op[3], k), sc(op[4], k), sc(op[5], k), sc(op[6], k));
            } else if (code == OP_POLYLINE) {
                dc.setPenWidth(pen(op[2], k));
                for (var j = 3; j + 3 < op.size(); j += 2) {
                    dc.drawLine(sc(op[j], k), sc(op[j + 1], k), sc(op[j + 2], k), sc(op[j + 3], k));
                }
            } else if (code == OP_POINTS) {
                var size = pen(op[2], k);
                for (var j = 3; j + 1 < op.size(); j += 2) {
                    if (size <= 1) {
                        dc.drawPoint(sc(op[j], k), sc(op[j + 1], k));
                    } else {
                        dc.fillRectangle(sc(op[j], k), sc(op[j + 1], k), size, size);
                    }
                }
            } else if (code == OP_RING) {
                dc.setPenWidth(pen(op[2], k));
                dc.drawCircle(sc(op[3], k), sc(op[4], k), sc(op[5], k));
            } else if (code == OP_RECT) {
                dc.fillRectangle(sc(op[2], k), sc(op[3], k), pen(op[4], k), pen(op[5], k));
            } else if (code == OP_STAR8) {
                dc.setPenWidth(pen(op[2], k));
                drawStar8(dc, sc(op[3], k), sc(op[4], k), sc(op[5], k));
            } else if (code == OP_FILL) {
                dc.fillRectangle(0, 0, dc.getWidth(), dc.getHeight());
            } else if (code == OP_CRESCENT) {
                dc.fillCircle(sc(op[3], k), sc(op[4], k), sc(op[5], k));
                dc.setColor(colors[op[2]] as Number, Graphics.COLOR_TRANSPARENT);
                dc.fillCircle(sc(op[3] + op[6], k), sc(op[4] + op[7], k), sc(op[8], k));
            } else if (code == OP_RRECT) {
                dc.fillRoundedRectangle(sc(op[2], k), sc(op[3], k), sc(op[4], k), sc(op[5], k), sc(op[6], k));
            } else if (code == OP_RRECT_LINE) {
                dc.setPenWidth(pen(op[2], k));
                dc.drawRoundedRectangle(sc(op[3], k), sc(op[4], k), sc(op[5], k), sc(op[6], k), sc(op[7], k));
            }
        }
        dc.setPenWidth(1);
    }

    // Outline of an 8-point star (Rub el Hizb): a square and the same square turned 45 deg.
    function drawStar8(dc as Graphics.Dc, x as Number, y as Number, r as Number) as Void {
        var d = (r * 0.7071 + 0.5).toNumber();
        dc.drawLine(x, y - r, x + r, y);
        dc.drawLine(x + r, y, x, y + r);
        dc.drawLine(x, y + r, x - r, y);
        dc.drawLine(x - r, y, x, y - r);
        dc.drawLine(x - d, y - d, x + d, y - d);
        dc.drawLine(x + d, y - d, x + d, y + d);
        dc.drawLine(x + d, y + d, x - d, y + d);
        dc.drawLine(x - d, y + d, x - d, y - d);
    }
}
