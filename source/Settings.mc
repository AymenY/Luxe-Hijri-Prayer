import Toybox.Application;
import Toybox.Lang;
import Toybox.Math;

// User settings, read from Application.Properties (resources/properties/properties.xml and
// resources/settings/settings.xml, both generated by tools/gen_settings.py). Every value is
// validated; an invalid value falls back to its default so the watch face always renders.
class LuxeSettings {

    // Appearance
    var preset as Number = 0;
    var background as Number = 0;
    var fontFamily as Number = 0;         // 0 Modern, 1 Classic, 2 Sport
    var textColor as Number = 0;          // 0 = preset, else Themes.TEXT_CHOICES[i - 1]
    var accentColor as Number = 0;        // 0 = preset, else Themes.COLOUR_CHOICES[i - 1]
    var handStyle as Number = 0;          // 0 baton, 1 dauphine, 2 sword
    var handColor as Number = 0;          // 0 = preset, else Themes.HAND_CHOICES[i - 1]
    var secondsMode as Number = 0;        // 0 always, 1 after wrist raise, 2 hidden
    var secondsColor as Number = 0;       // 0 = preset, else Themes.COLOUR_CHOICES[i - 1]
    // Data fields
    var gauges as Array<Number> = [0, 1, 2, 10];
    var gaugeColors as Number = 0;        // 0 per data type, 1 accent, 2 text
    // Faith & calendar
    var hijriArabic as Boolean = true;
    var hijriCorrection as Number = 0;
    var ayahMode as Number = 0;           // 0 hourly rotation, 1 fixed, 2 hidden
    var ayahFixed as Number = 18;
    var ayahIncluded as Array<Boolean> = [] as Array<Boolean>;
    var method as Number = 0;
    var asrFactor as Number = 1;          // 1 = standard, 2 = Hanafi
    var highLat as Number = 1;
    var latitude as Double = 33.8754d;
    var longitude as Double = 10.8575d;
    var locationSet as Boolean = true;
    var tzManual as Boolean = false;
    var utcOffsetSeconds as Number = 3600;

    const AYAH_COUNT = 39;

    function initialize() {
    }

    function load() as Void {
        preset = readList("StylePreset", Themes.COUNT - 1, 0);
        background = readList("Background", 3, 0);
        fontFamily = readList("FontFamily", 2, 0);
        textColor = readList("TextColor", Themes.TEXT_CHOICES.size(), 0);
        accentColor = readList("AccentColor", Themes.COLOUR_CHOICES.size(), 0);
        handStyle = readList("HandStyle", 2, 0);
        handColor = readList("HandColor", Themes.HAND_CHOICES.size(), 0);
        secondsMode = readList("SecondsMode", 2, 0);
        secondsColor = readList("SecondsColor", Themes.COLOUR_CHOICES.size(), 0);

        var last = DataFields.SUN_RING;
        gauges = [readList("Gauge1", last, 0), readList("Gauge2", last, 1),
                  readList("Gauge3", last, 2), readList("Gauge4", last, DataFields.SUN_RING)];
        gaugeColors = readList("GaugeColors", 2, 0);

        hijriArabic = readList("HijriScript", 1, 0) == 0;
        hijriCorrection = readList("HijriCorrection", 4, 2) - 2;
        ayahMode = readList("AyahMode", 2, 0);
        ayahFixed = readList("AyahFixed", AYAH_COUNT - 1, 18);
        ayahIncluded = [] as Array<Boolean>;
        for (var i = 1; i <= AYAH_COUNT; i++) {
            ayahIncluded.add(readBool("AyahInc" + i.format("%02d"), true));
        }

        method = readList("CalcMethod", PrayerTimes.METHODS.size() - 1, 0);
        asrFactor = readList("AsrMethod", 1, 0) + 1;
        highLat = readList("HighLatRule", 3, 1);
        latitude = readDegrees("Latitude", 90.0d, 33.8754d);
        longitude = readDegrees("Longitude", 180.0d, 10.8575d);
        // 0/0 (the Gulf of Guinea) is what an empty numeric field turns into: treat it as
        // "not configured" and ask the user to set a location instead of showing wrong times.
        locationSet = !(latitude == 0.0d && longitude == 0.0d);
        tzManual = readList("TimeZoneMode", 1, 0) == 1;
        var off = readDegrees("UtcOffset", 14.0d, 1.0d);
        if (off < -12.0d) {
            off = -12.0d;
        }
        // whole minutes (offsets such as +5:30 and +5:45 exist)
        utcOffsetSeconds = Math.round(off * 60.0d).toNumber() * 60;
    }

    hidden function readRaw(key as String) {
        try {
            return Application.Properties.getValue(key);
        } catch (e) {
            return null;
        }
    }

    // Raw property value as a Double, or null.
    hidden function readNumeric(key as String) as Double? {
        var v = readRaw(key);
        if (v instanceof Number || v instanceof Float || v instanceof Double || v instanceof Long) {
            return v.toDouble();
        }
        if (v instanceof String) {
            var f = v.toFloat();
            if (f != null) {
                return f.toDouble();
            }
        }
        return null;
    }

    hidden function readBool(key as String, def as Boolean) as Boolean {
        var v = readRaw(key);
        if (v instanceof Boolean) {
            return v;
        }
        return def;
    }

    // List index in 0..max, or the default.
    hidden function readList(key as String, max as Number, def as Number) as Number {
        var v = readNumeric(key);
        if (v == null) {
            return def;
        }
        var n = v.toNumber();
        if (n < 0 || n > max) {
            return def;
        }
        return n;
    }

    // Value in -limit..limit (NaN and out-of-range values use the default).
    hidden function readDegrees(key as String, limit as Double, def as Double) as Double {
        var v = readNumeric(key);
        if (v == null || v != v || v > limit || v < -limit) {
            return def;
        }
        return v;
    }
}

// Which verse to show. Pure function so that it can be unit-tested.
module AyahPicker {

    // Returns the verse index (0..count-1) or -1 when the Ayah is hidden.
    // mode 0: hourly rotation over the included verses (falls back to `fixed` if none is
    // included); mode 1: the fixed verse; mode 2: hidden. `hour` = local hours since 1970.
    function pick(mode as Number, fixed as Number, included as Array<Boolean>, hour as Number) as Number {
        if (mode == 2) {
            return -1;
        }
        if (mode == 1) {
            return fixed;
        }
        var n = 0;
        for (var i = 0; i < included.size(); i++) {
            if (included[i]) {
                n++;
            }
        }
        if (n == 0) {
            return fixed;
        }
        var k = hour % n;
        for (var i = 0; i < included.size(); i++) {
            if (included[i]) {
                if (k == 0) {
                    return i;
                }
                k--;
            }
        }
        return fixed;
    }
}
