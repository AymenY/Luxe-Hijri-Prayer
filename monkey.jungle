project.manifest = manifest.xml

# test/ holds (:test) functions; they are only compiled into unit-test builds.
# resources/ and the language folder resources-fre/ are picked up by the default resource path rules.
base.sourcePath = source;test

# Two variants of the dial (generated by tools/update_products.py):
# * Connect IQ 4+ watches: HD images from hd/<screen size>/ and the (:hd) code;
# * Connect IQ 3 watches: vector dial, (:lite) code, no HD images (images would count against
#   the 96-128 KB of app memory these watches give a watch face).
base.excludeAnnotations = lite

